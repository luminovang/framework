use Luminova\Boot;
use Luminova\Command\Worker;
use Luminova\Command\Novakit;

// Autoload framework models
require __DIR__ . '/system/Boot.php';

// Register CLI initializations
Boot::cli();

// Pointing to project root
chdir(APP_ROOT);

// Run background async future task
if(($argv[1] ?? null) === 'async'){
    ini_set('error_log', 'php://stderr');

    exit(Worker::run($argv ?? [], (int) getmypid()));
}

// Run Novakit CLI Console or Background Future task
Novakit::run($argv ?? []);